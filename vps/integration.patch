+router.post('/refresh', async (req, res) => {
+  if (!requireConfiguredSupabase(res)) return;
+  const token = req.body?.refresh_token;
+  if (typeof token !== 'string' || !token || token.length > 8192) return res.status(400).json({ error: 'A refresh token is required.' });
+  try {
+    const { data, error } = await authClient().auth.refreshSession({ refresh_token: token });
+    if (error || !data.session) return res.status(401).json({ error: 'Your session expired. Sign in again.' });
